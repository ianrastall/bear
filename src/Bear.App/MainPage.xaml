<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Bear.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bear.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Board first, everything else subordinate. The only chrome is a clock strip
        above and below; every other command lives on the board's right-click menu.
    -->
    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Opponent: strength only. No name, no avatar.  -->
        <Grid Padding="6,2">
            <TextBlock
                x:Name="OpponentText"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="#9AA0A6"
                Text="Opponent 1500" />
            <!--  Black's clock: dark face, light digits, as on a real clock.  -->
            <Border
                x:Name="BlackClockBox"
                Padding="16,3"
                HorizontalAlignment="Right"
                Background="#26262A"
                BorderBrush="#3C3C42"
                BorderThickness="1"
                CornerRadius="5">
                <TextBlock
                    x:Name="BlackClockText"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="#EDEDED"
                    Text="10:00" />
            </Border>
        </Grid>

        <controls:ChessBoardView
            x:Name="BoardView"
            Grid.Row="1"
            Margin="0,6"
            BoardChanged="OnBoardChanged"
            GameReset="OnGameReset" />

        <Grid Grid.Row="2" Padding="6,2">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="#9AA0A6"
                Text="" />
            <!--  White's clock: light face, dark digits.  -->
            <Border
                x:Name="WhiteClockBox"
                Padding="16,3"
                HorizontalAlignment="Right"
                Background="#E8E8E4"
                BorderBrush="#BDBDB6"
                BorderThickness="1"
                CornerRadius="5">
                <TextBlock
                    x:Name="WhiteClockText"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="#1A181C"
                    Text="10:00" />
            </Border>
        </Grid>
    </Grid>
</Page>
