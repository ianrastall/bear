<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M4's acceptance test. Not part of the solution and not shipped: it exists to prove the
    C# encoder matches maia2's Python, by linking the real source file rather than a copy.
    Run from the repo root with: dotnet run, project tools/Bear.Maia.Verify
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier></RuntimeIdentifier>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Bear.App\Maia\MaiaEncoder.cs" Link="MaiaEncoder.cs" />
    <Compile Include="..\..\src\Bear.App\Maia\MaiaPolicy.cs" Link="MaiaPolicy.cs" />
  </ItemGroup>

</Project>
