<Project>

  <!--
    Solution-wide build settings. This project is deliberately win-x64 only:
    no AnyCPU, no x86, no ARM64. Every project inherits the RID from here so a
    stray platform can't sneak in via a per-project default.
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Deterministic, reproducible output. -->
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>

    <Product>Bear</Product>
    <Company>Bear</Company>
  </PropertyGroup>

</Project>
